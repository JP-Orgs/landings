---
import { faqs } from "../data/content";
---

<div id="faq" class="section-wrap section-pad">
  <div
    style="display: flex; flex-direction: column; align-items: center; text-align: center; gap: 12px; margin: 0 auto 32px;"
  >
    <h2 style="font-size: 34px; letter-spacing: -0.01em; color: oklch(15% 0.01 80);">
      Preguntas frecuentes
    </h2>
  </div>
  <div style="display: flex; flex-direction: column; gap: 12px; max-width: 720px; margin: 0 auto;">
    {
      faqs.map((faq) => (
        <details class="card" style="padding: 20px 24px">
          <summary style="cursor: pointer; font-weight: 600; font-size: 16px; color: oklch(20% 0.01 80);">
            {faq.question}
          </summary>
          <p style="margin-top: 12px; font-size: 15px; line-height: 1.6; color: oklch(38% 0.01 80);">
            {faq.answer}
          </p>
        </details>
      ))
    }
  </div>
</div>
