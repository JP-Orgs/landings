---
import { business } from "../data/content";
const year = new Date().getFullYear();
---

<div style="border-top: 1px solid oklch(85% 0.012 72)">
  <div
    style="max-width: 1280px; margin: 0 auto; padding: 40px 24px 28px; display: flex; flex-direction: column; gap: 24px;"
  >
    <div style="display: flex; flex-direction: column; gap: 6px">
      <span
        style="font-family: 'Bricolage Grotesque', sans-serif; font-weight: 700; font-size: 18px; letter-spacing: -0.01em; color: oklch(20% 0.01 80);"
      >
        {business.name}
      </span>
      <span style="font-size: 14px; color: oklch(45% 0.01 80)">
        Fabricación de muebles a medida en {business.locality}, {business.region}.
      </span>
    </div>
    <div style="border-top: 1px solid oklch(90% 0.01 75); padding-top: 16px">
      <span style="font-size: 13px; color: oklch(55% 0.01 80)">
        © {year} {business.name}
      </span>
    </div>
  </div>
</div>
