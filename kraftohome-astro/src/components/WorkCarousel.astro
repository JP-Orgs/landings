---
import { work } from "../data/content";
---

<div id="work" class="section-wrap section-pad">
  <div
    style="display: flex; flex-direction: column; align-items: center; text-align: center; gap: 12px; margin: 0 auto 48px; max-width: 640px;"
  >
    <h2 style="font-size: 34px; letter-spacing: -0.01em; color: oklch(15% 0.01 80);">
      Algunos de nuestros productos
    </h2>
    <p style="font-size: 16px; color: oklch(38% 0.01 80); line-height: 1.6">
      Una muestra de vestidores, placares y cocinas fabricados e instalados a medida.
    </p>
  </div>
  <div class="carousel-wrapper" style="position: relative">
    <div
      id="work-track"
      class="carousel-track"
      style="display: flex; gap: 24px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-left: 24px; padding-bottom: 8px;"
    >
      {
        work.map((item, i) => (
          <div
            id={`work-item-${i}`}
            class="card"
            style="flex: 0 0 min(640px, 82%); scroll-snap-align: start; overflow: hidden;"
          >
            <img
              src={item.photo}
              alt={item.alt}
              width="640"
              height="480"
              loading="lazy"
              style="width: 100%; aspect-ratio: 4/3; object-fit: cover; display: block;"
            />
          </div>
        ))
      }
    </div>
    <button
      data-scroll="work-track" data-amount="560"
      data-dir="-1"
      aria-label="Anterior"
      class="carousel-arrow"
      style="position: absolute; left: -20px; top: 50%; transform: translateY(-50%); width: 44px; height: 44px; border-radius: 50%; border: 1px solid oklch(91% 0.008 80); background: oklch(99% 0.004 80); box-shadow: 0 4px 12px oklch(0% 0 0 / 0.1); cursor: pointer; display: flex; align-items: center; justify-content: center; color: oklch(20% 0.01 80);"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M15 18l-6-6 6-6"></path>
      </svg>
    </button>
    <button
      data-scroll="work-track" data-amount="560"
      data-dir="1"
      aria-label="Siguiente"
      class="carousel-arrow"
      style="position: absolute; right: -20px; top: 50%; transform: translateY(-50%); width: 44px; height: 44px; border-radius: 50%; border: 1px solid oklch(91% 0.008 80); background: oklch(99% 0.004 80); box-shadow: 0 4px 12px oklch(0% 0 0 / 0.1); cursor: pointer; display: flex; align-items: center; justify-content: center; color: oklch(20% 0.01 80);"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M9 18l6-6-6-6"></path>
      </svg>
    </button>
  </div>
  <div style="display: flex; justify-content: center; gap: 8px; margin-top: 20px;">
    {
      work.map((_, i) => (
        <button
          data-goto={`work-item-${i}`}
          aria-label={`Ir a la foto ${i + 1}`}
          class="carousel-dot"
          style="width: 8px; height: 8px; padding: 0; border: none; border-radius: 50%; cursor: pointer; background: oklch(80% 0.01 80);"
        />
      ))
    }
  </div>
</div>
